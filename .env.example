# Required by every profile. Generate once with: openssl rand -hex 32
# Keep the same value across restarts; changing it invalidates encrypted data.
SECRET_KEY=

# Optional exact reverse-proxy origins, comma-separated.
SOCKETIO_ALLOWED_ORIGINS=

# Optional numeric group owning Linux USB device nodes. Nutify detects this
# automatically; set it only when container startup reports no USB device GID.
NUTIFY_USB_GID=

# Required only with docker-compose.hardware.yaml for a stable serial or
# non-USB device path. These values do not select Single/Multi monitoring.
NUTIFY_DEVICE=
NUTIFY_DEVICE_CONTAINER=/dev/nutify-ups
NUTIFY_DEVICE_GID=

# Optional OpenID Connect SSO.
# - database: configure and validate SSO in System -> Authentication.
# - environment: use docker-compose.oidc.yaml and define every required value.
# HTTPS issuer/callback and explicit authorization groups are required.
OIDC_CONFIG_SOURCE=database
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email groups
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=
OIDC_USER_GROUP=
OIDC_ALLOW_ALL_USERS=false
OIDC_PROVIDER_NAME=SSO
OIDC_BUTTON_LABEL=
OIDC_AUTO_REDIRECT=false
# Local development only. Never enable for a production provider.
OIDC_ALLOW_INSECURE_HTTP=false
